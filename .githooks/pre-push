#!/bin/sh
set -u

root=$(CDPATH= cd -- "$(git rev-parse --show-toplevel)" && pwd)
failed=""

run() {
    name=$1
    printf '\n===== %s =====\n' "$name"
    if ! "$@"; then
        failed="$failed $name"
    fi
}

package_arch() {
    REPO_DB="/var/lib/pacman-local/pacman-local.db.tar.gz"
    REPO_PATH="$(dirname "$REPO_DB")"

    TMP_DIR="$(mktemp -d)"
    export PKGDEST="$TMP_DIR"
    cd "$root"/contrib/arch || exit 1
    makepkg -s

    if [ -d "$REPO_PATH" ]; then
        for pkg in "$PKGDEST"/*.pkg.tar.zst; do
            mv "$pkg" "$REPO_PATH/"
            repo-add "$REPO_DB" "$REPO_PATH/$(basename "$pkg")"
        done
        git restore PKGBUILD
    fi
}


if grep -q ID=arch /etc/os-release > /dev/null 2>&1 ; then
    run package_arch
fi

if [ -n "$failed" ]; then
    printf '\nfailed:%s\n' "$failed"
    exit 1
fi

printf '\nall checks passed\n'
