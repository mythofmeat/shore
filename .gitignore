# Rust. Deliberately not root-anchored: the Cargo workspace lives in client/,
# and a `/target/` rule would silently stop matching if it moved again.
target/
**/*.rs.bk
*.profraw
*.profdata
bun.lock

# IDE / AI tooling
.idea/
.vscode/
# Track committed agent skills/config under .claude/, but never the local
# worktree checkouts the harness creates there.
.claude/worktrees/
.codex
.skill-staging/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Runtime / data
*.db
*.sqlite
*.sqlite3
*.log
*.sock
*.pid

# makepkg build artifacts. contrib/arch/PKGBUILD builds the working tree in
# place, so src/ only appears if makepkg was interrupted before `-c` cleaned up.
**/pkg/
*.pkg.tar.zst
contrib/arch/src/

# Gitea runner
.runner

# Bench / experiment generated artifacts (regenerable from fixtures + scripts)
experiments/auto-memory-gate/shore-bench/templates/
experiments/auto-memory-gate/shore-bench/results/
experiments/**/__pycache__/
experiments/**/.venv/
experiments/**/.venv-*/
experiments/memory-framework-eval/mem0_store/
experiments/memory-framework-eval/.letta/
experiments/memory-framework-eval/.letta-pgdata/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
test_char
.worktree
.worktrees/
sweep.timestamp
nohup.out
