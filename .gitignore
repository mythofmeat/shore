# Rust. Deliberately not root-anchored: the Cargo workspace lives in client/,
# and a `/target/` rule would silently stop matching if it moved again.
target/
**/*.rs.bk
*.profraw
*.profdata
bun.lock

# IDE / AI tooling
.idea/
.vscode/
# Track committed agent skills/config under .claude/, but never the local
# worktree checkouts the harness creates there.
.claude/worktrees/
.codex
.skill-staging/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Runtime / data
*.db
*.sqlite
*.sqlite3
*.log
*.sock
*.pid

**/pkg/
*.pkg.tar.zst
contrib/arch/src/
contrib/arch/shore/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
test_char
.worktree
.worktrees/
sweep.timestamp
nohup.out
__pycache__/
