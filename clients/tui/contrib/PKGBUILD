# Maintainer: eshen
pkgname=shore-tui
pkgver=0.1.0
pkgrel=1
pkgdesc='Terminal UI client for the Silvershore chat daemon'
arch=('x86_64')
url='https://github.com/mythofmeat/shore-tui'
license=('MIT OR Apache-2.0')
depends=('gcc-libs')
optdepends=('wl-clipboard: ctrl+v image paste from clipboard (Wayland)')
makedepends=('cargo' 'git')
provides=('shore-tui')
conflicts=('shore-tui' 'shore-git')
source=("${pkgname}::git+ssh://git@github.com/mythofmeat/shore-tui.git")
options=('!lto')
sha256sums=('SKIP')

prepare() {
    cd "${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen
}

package() {
    cd "${pkgname}"
    install -Dm755 target/release/shore-tui "$pkgdir/usr/bin/shore-tui"
}
