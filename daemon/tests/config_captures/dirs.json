{
  "passwd_home": "/root",
  "shore_dirs": [
    {
      "name": "SHORE_* overrides win and are used verbatim, with no /shore suffix",
      "env": {
        "SHORE_CONFIG_DIR": "/o/cfg",
        "SHORE_DATA_DIR": "/o/data",
        "SHORE_RUNTIME_DIR": "/o/run",
        "SHORE_CACHE_DIR": "/o/cache",
        "XDG_CONFIG_HOME": "/x/cfg",
        "HOME": "/home/u"
      },
      "config": "/o/cfg",
      "data": "/o/data",
      "runtime": "/o/run",
      "cache": "/o/cache"
    },
    {
      "name": "absolute XDG vars get /shore appended",
      "env": {
        "XDG_CONFIG_HOME": "/x/cfg",
        "XDG_DATA_HOME": "/x/data",
        "XDG_RUNTIME_DIR": "/x/run",
        "XDG_CACHE_HOME": "/x/cache",
        "HOME": "/home/u"
      },
      "config": "/x/cfg/shore",
      "data": "/x/data/shore",
      "runtime": "/x/run/shore",
      "cache": "/x/cache/shore"
    },
    {
      "name": "an empty XDG var is Ok(\"\") and short-circuits the platform lookup",
      "env": {
        "XDG_CONFIG_HOME": "",
        "HOME": "/home/u"
      },
      "config": "shore",
      "data": "/home/u/.local/share/shore",
      "runtime": "/tmp/shore",
      "cache": "/home/u/.cache/shore"
    },
    {
      "name": "a relative XDG var is taken as-is, though the dirs crate would reject it",
      "env": {
        "XDG_CONFIG_HOME": "cfg",
        "HOME": "/home/u"
      },
      "config": "cfg/shore",
      "data": "/home/u/.local/share/shore",
      "runtime": "/tmp/shore",
      "cache": "/home/u/.cache/shore"
    },
    {
      "name": "an unnormalized XDG var stays unnormalized",
      "env": {
        "XDG_CONFIG_HOME": "/x/a/../b",
        "HOME": "/home/u"
      },
      "config": "/x/a/../b/shore",
      "data": "/home/u/.local/share/shore",
      "runtime": "/tmp/shore",
      "cache": "/home/u/.cache/shore"
    },
    {
      "name": "HOME only: platform defaults",
      "env": {
        "HOME": "/home/u"
      },
      "config": "/home/u/.config/shore",
      "data": "/home/u/.local/share/shore",
      "runtime": "/tmp/shore",
      "cache": "/home/u/.cache/shore"
    },
    {
      "name": "nothing set: getpwuid answers, so the ~ literal is not reached",
      "env": {},
      "config": "/root/.config/shore",
      "data": "/root/.local/share/shore",
      "runtime": "/tmp/shore",
      "cache": "/root/.cache/shore"
    },
    {
      "name": "an empty HOME is treated as unset and falls through to getpwuid",
      "env": {
        "HOME": ""
      },
      "config": "/root/.config/shore",
      "data": "/root/.local/share/shore",
      "runtime": "/tmp/shore",
      "cache": "/root/.cache/shore"
    },
    {
      "name": "XDG_RUNTIME_DIR has no platform fallback, so runtime lands in the temp dir",
      "env": {
        "XDG_CONFIG_HOME": "/x/cfg",
        "HOME": "/home/u"
      },
      "config": "/x/cfg/shore",
      "data": "/home/u/.local/share/shore",
      "runtime": "/tmp/shore",
      "cache": "/home/u/.cache/shore"
    }
  ],
  "deep_merge": [
    {
      "name": "overlay scalar overwrites base scalar",
      "base": "a = 1\nb = 2",
      "overlay": "a = 9",
      "merged": {
        "a": 9,
        "b": 2
      }
    },
    {
      "name": "new keys are added",
      "base": "a = 1",
      "overlay": "b = 2",
      "merged": {
        "a": 1,
        "b": 2
      }
    },
    {
      "name": "tables recurse rather than replace",
      "base": "[t]\na = 1\nb = 2",
      "overlay": "[t]\nb = 9\nc = 3",
      "merged": {
        "t": {
          "a": 1,
          "b": 9,
          "c": 3
        }
      }
    },
    {
      "name": "arrays are replaced wholesale, not concatenated",
      "base": "a = [1, 2, 3]",
      "overlay": "a = [9]",
      "merged": {
        "a": [
          9
        ]
      }
    },
    {
      "name": "an empty overlay changes nothing",
      "base": "[t]\na = 1",
      "overlay": "",
      "merged": {
        "t": {
          "a": 1
        }
      }
    },
    {
      "name": "a table in the overlay replaces a scalar in the base",
      "base": "a = 1",
      "overlay": "[a]\nb = 2",
      "merged": {
        "a": {
          "b": 2
        }
      }
    },
    {
      "name": "a scalar in the overlay replaces a table in the base",
      "base": "[a]\nb = 2",
      "overlay": "a = 1",
      "merged": {
        "a": 1
      }
    },
    {
      "name": "recursion goes all the way down",
      "base": "[a.b.c]\nx = 1\ny = 2",
      "overlay": "[a.b.c]\ny = 9\nz = 3",
      "merged": {
        "a": {
          "b": {
            "c": {
              "x": 1,
              "y": 9,
              "z": 3
            }
          }
        }
      }
    },
    {
      "name": "an array of tables is a value, not a table",
      "base": "[[a]]\nx = 1",
      "overlay": "[[a]]\ny = 2",
      "merged": {
        "a": [
          {
            "y": 2
          }
        ]
      }
    }
  ],
  "raw_config": [
    {
      "name": "config.toml alone",
      "files": [
        {
          "path": "config.toml",
          "content": "[tools]\nmax_result_chars = 1\n\n[retrieval]\nmax_files = 2\n"
        }
      ],
      "config_path": null,
      "ok": {
        "table": {
          "tools": {
            "max_result_chars": 1
          },
          "memory": {
            "retrieval": {
              "max_indexed_files": 2
            }
          }
        },
        "config_dir_rel": ""
      }
    },
    {
      "name": "no config.toml at all yields an empty table",
      "files": [],
      "config_path": null,
      "ok": {
        "table": {},
        "config_dir_rel": ""
      }
    },
    {
      "name": "include is removed from the table and its file merged over it",
      "files": [
        {
          "path": "config.toml",
          "content": "include = [\"extra.toml\"]\ntools.max_result_chars = 1\nchat.max_retries = 1"
        },
        {
          "path": "extra.toml",
          "content": "chat.max_retries = 2\ncompaction.max_context_tokens = 3"
        }
      ],
      "config_path": null,
      "ok": {
        "table": {
          "tools": {
            "max_result_chars": 1
          },
          "advanced": {
            "max_retries": 2
          },
          "memory": {
            "compaction": {
              "max_context_tokens": 3
            }
          }
        },
        "config_dir_rel": ""
      }
    },
    {
      "name": "includes merge in written order, last wins",
      "files": [
        {
          "path": "config.toml",
          "content": "include = [\"one.toml\", \"two.toml\"]\ntools.max_result_chars = 10"
        },
        {
          "path": "one.toml",
          "content": "tools.max_result_chars = 11"
        },
        {
          "path": "two.toml",
          "content": "tools.max_result_chars = 12"
        }
      ],
      "config_path": null,
      "ok": {
        "table": {
          "tools": {
            "max_result_chars": 12
          }
        },
        "config_dir_rel": ""
      }
    },
    {
      "name": "a missing include is skipped, not an error",
      "files": [
        {
          "path": "config.toml",
          "content": "include = [\"nope.toml\"]\ntools.max_result_chars = 1"
        }
      ],
      "config_path": null,
      "ok": {
        "table": {
          "tools": {
            "max_result_chars": 1
          }
        },
        "config_dir_rel": ""
      }
    },
    {
      "name": "an include that does not parse is fatal",
      "files": [
        {
          "path": "config.toml",
          "content": "include = [\"bad.toml\"]"
        },
        {
          "path": "bad.toml",
          "content": "this is not toml"
        }
      ],
      "config_path": null,
      "error_kind": "parse_include"
    },
    {
      "name": "a non-string include entry is rejected",
      "files": [
        {
          "path": "config.toml",
          "content": "include = [42]\ntools.max_result_chars = 1"
        }
      ],
      "config_path": null,
      "error_kind": "parse_app"
    },
    {
      "name": "conf.d merges in sorted filename order and beats include",
      "files": [
        {
          "path": "config.toml",
          "content": "include = [\"inc.toml\"]\ntools.max_result_chars = 10"
        },
        {
          "path": "inc.toml",
          "content": "tools.max_result_chars = 11"
        },
        {
          "path": "conf.d/20-b.toml",
          "content": "tools.max_result_chars = 13"
        },
        {
          "path": "conf.d/10-a.toml",
          "content": "tools.max_result_chars = 12"
        }
      ],
      "config_path": null,
      "ok": {
        "table": {
          "tools": {
            "max_result_chars": 13
          }
        },
        "config_dir_rel": ""
      }
    },
    {
      "name": "conf.d skips non-.toml, .TOML, and a bare .toml dotfile",
      "files": [
        {
          "path": "config.toml",
          "content": "tools.max_result_chars = 10"
        },
        {
          "path": "conf.d/a.toml",
          "content": "tools.max_result_chars = 11"
        },
        {
          "path": "conf.d/b.txt",
          "content": "skipped_txt = 1"
        },
        {
          "path": "conf.d/c.TOML",
          "content": "skipped_upper = 1"
        },
        {
          "path": "conf.d/.toml",
          "content": "skipped_dotfile = 1"
        },
        {
          "path": "conf.d/notatoml",
          "content": "skipped_no_dot = 1"
        },
        {
          "path": "conf.d/a.xtoml",
          "content": "skipped_suffix_only = 1"
        },
        {
          "path": "conf.d/d.b.toml",
          "content": "tools.timeout = \"5s\""
        }
      ],
      "config_path": null,
      "ok": {
        "table": {
          "tools": {
            "max_result_chars": 11,
            "timeout": "5s"
          }
        },
        "config_dir_rel": ""
      }
    },
    {
      "name": "conf.d order is by code point, and beats directory order",
      "files": [
        {
          "path": "config.toml",
          "content": "tools.max_result_chars = 10"
        },
        {
          "path": "conf.d/z.toml",
          "content": "tools.max_result_chars = 11"
        },
        {
          "path": "conf.d/a.toml",
          "content": "tools.max_result_chars = 12"
        },
        {
          "path": "conf.d/🎵.toml",
          "content": "compaction.max_turns = 1\ntools.max_result_chars = 19"
        },
        {
          "path": "conf.d/ﬀ.toml",
          "content": "compaction.max_turns = 2"
        }
      ],
      "config_path": null,
      "ok": {
        "table": {
          "memory": {
            "compaction": {
              "max_turns": 1
            }
          },
          "tools": {
            "max_result_chars": 19
          }
        },
        "config_dir_rel": ""
      }
    },
    {
      "name": "conf.d that is a file, not a directory, is fatal",
      "files": [
        {
          "path": "config.toml",
          "content": "tools.max_result_chars = 10"
        },
        {
          "path": "conf.d",
          "content": "not a directory"
        }
      ],
      "config_path": null,
      "error_kind": "read_file"
    },
    {
      "name": "a conf.d file that does not parse is fatal",
      "files": [
        {
          "path": "config.toml",
          "content": "tools.max_result_chars = 10"
        },
        {
          "path": "conf.d/bad.toml",
          "content": "= nope"
        }
      ],
      "config_path": null,
      "error_kind": "conf_d"
    },
    {
      "name": "conf.d deep-merges rather than replacing whole tables",
      "files": [
        {
          "path": "config.toml",
          "content": "[retrieval]\nmax_file_bytes = 1\nmax_files = 2\n"
        },
        {
          "path": "conf.d/z.toml",
          "content": "[retrieval]\nmax_files = 9\nmax_total_bytes = 3\n"
        }
      ],
      "config_path": null,
      "ok": {
        "table": {
          "memory": {
            "retrieval": {
              "max_file_bytes": 1,
              "max_indexed_files": 9,
              "max_total_indexed_bytes": 3
            }
          }
        },
        "config_dir_rel": ""
      }
    },
    {
      "name": "an explicit config path re-homes the config dir to its parent",
      "files": [
        {
          "path": "nested/other.toml",
          "content": "include = [\"sib.toml\"]\ntools.max_result_chars = 1"
        },
        {
          "path": "nested/sib.toml",
          "content": "chat.max_retries = 2"
        },
        {
          "path": "nested/conf.d/x.toml",
          "content": "compaction.max_context_tokens = 3"
        },
        {
          "path": "conf.d/should-not-load.toml",
          "content": "compaction.min_turns = 4"
        }
      ],
      "config_path": "nested/other.toml",
      "ok": {
        "table": {
          "tools": {
            "max_result_chars": 1
          },
          "advanced": {
            "max_retries": 2
          },
          "memory": {
            "compaction": {
              "max_context_tokens": 3
            }
          }
        },
        "config_dir_rel": "nested"
      }
    },
    {
      "name": "config.toml that does not parse is fatal",
      "files": [
        {
          "path": "config.toml",
          "content": "this is not toml"
        }
      ],
      "config_path": null,
      "error_kind": "parse_app"
