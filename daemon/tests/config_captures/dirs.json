  "char_config": [
    {
      "name": "no override file yields None",
      "global": "\n",
      "overlay": null,
      "merged": null
    },
    {
      "name": "the overlay deep-merges over the global raw table",
      "global": "[chat]\nuser_timestamps = \"always\"\ndisplay_name = \"Global\"\n",
      "overlay": "[chat]\ndisplay_name = \"Character\"\n",
      "merged": {
        "behavior": {
          "user_message_timestamps": "always"
        },
        "defaults": {
          "display_name": "Character"
        }
      }
    },
    {
      "name": "a table the overlay does not mention keeps every global key",
      "global": "[tools]\nmax_result_chars = 100\nenabled = [\"read\"]\n\n[compaction]\nenabled = true\n",
      "overlay": "[tools]\nmax_result_chars = 200",
      "merged": {
        "memory": {
          "compaction": {
            "enabled": true
          }
        },
        "tools": {
          "enabled_tools": [
            "read"
          ],
          "max_result_chars": 200
        }
      }
    },
    {
      "name": "an array in the overlay replaces rather than extends",
      "global": "[tools]\nenabled = [\"read\", \"write\"]\n",
      "overlay": "[tools]\nenabled = [\"read\"]\n",
      "merged": {
        "tools": {
          "enabled_tools": [
            "read"
          ]
        }
      }
    }
  ],
