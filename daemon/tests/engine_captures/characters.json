    {
      "name": "empty config dir",
      "seed": {
        "global_toml": "[daemon]\nlisten_addr = \"127.0.0.1:9999\"\n\n[chat]\ndisplay_name = \"GLOBAL\"\n",
        "raw_table": true,
        "characters": []
      },
      "steps": [
        {
          "op": "new",
          "state": {
            "available": [],
            "snapshots": []
          }
        },
        {
          "op": "has_character",
          "name": "Alice",
          "result": false
        },
        {
          "op": "resolve_character",
          "requested": null,
          "result": {
            "err": "no characters available \u2014 create one at characters/<name>/workspace/SOUL.md",
            "variant": "none_available"
          }
        },
        {
          "op": "resolve_character",
          "requested": "Alice",
          "result": {
            "err": "character \"Alice\" not found (available: [])",
            "variant": "not_found"
          }
        }
      ]
    },
