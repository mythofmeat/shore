{
  "timezone": "America/New_York",
  "archive_and_retain": [
    {
      "name": "keeping fewer than there are archives the rest",
      "note": "the split is by line, from the end: the last `keep_last_n` stay",
      "input": {
        "active_content_lines": 3,
        "active_content": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n",
        "keep_last_n": 1,
        "existing_manifest": null,
        "on_disk_differs": false
      },
      "output": {
        "ok": true,
        "error": null,
        "returns_uuid": true,
        "segments": [
          {
            "file": "0001.jsonl",
            "lines": [
              "m_1",
              "m_2"
            ]
          }
        ],
        "manifest": {
          "segments": [
            {
              "file": "0001.jsonl",
              "message_count": 2,
              "compacted_at": "<stamp>"
            }
          ],
          "total_compacted_messages": 2
        },
        "retained": [
          "m_3"
        ],
        "retained_raw": "{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n"
      }
    },
    {
      "name": "keeping all of them writes no segment",
      "note": "and leaves active.jsonl exactly as it was",
      "input": {
        "active_content_lines": 3,
        "active_content": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n",
        "keep_last_n": 3,
        "existing_manifest": null,
        "on_disk_differs": false
      },
      "output": {
        "ok": true,
        "error": null,
        "returns_uuid": true,
        "segments": [],
        "manifest": null,
        "retained": [
          "m_1",
          "m_2",
          "m_3"
        ],
        "retained_raw": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n"
      }
    },
    {
      "name": "keeping more than there are is not an error",
      "note": "the keep count is clamped to what exists",
      "input": {
        "active_content_lines": 3,
        "active_content": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n",
        "keep_last_n": 99,
        "existing_manifest": null,
        "on_disk_differs": false
      },
      "output": {
        "ok": true,
        "error": null,
        "returns_uuid": true,
        "segments": [],
        "manifest": null,
        "retained": [
          "m_1",
          "m_2",
          "m_3"
        ],
        "retained_raw": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n"
      }
    },
    {
      "name": "keeping exactly one more than there are",
      "note": "the interesting side of the clamp: one past the end, where an unclamped subtraction goes negative by one rather than by a lot",
      "input": {
        "active_content_lines": 3,
        "active_content": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n",
        "keep_last_n": 4,
        "existing_manifest": null,
        "on_disk_differs": false
      },
      "output": {
        "ok": true,
        "error": null,
        "returns_uuid": true,
        "segments": [],
        "manifest": null,
        "retained": [
          "m_1",
          "m_2",
          "m_3"
        ],
        "retained_raw": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n"
      }
    },
    {
      "name": "keeping none archives everything and empties the file",
      "note": "an empty active.jsonl is written as empty, not as a blank line",
      "input": {
        "active_content_lines": 3,
        "active_content": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n",
        "keep_last_n": 0,
        "existing_manifest": null,
        "on_disk_differs": false
      },
      "output": {
        "ok": true,
        "error": null,
        "returns_uuid": true,
        "segments": [
          {
            "file": "0001.jsonl",
            "lines": [
              "m_1",
              "m_2",
              "m_3"
            ]
          }
        ],
        "manifest": {
          "segments": [
            {
              "file": "0001.jsonl",
              "message_count": 3,
              "compacted_at": "<stamp>"
            }
          ],
          "total_compacted_messages": 3
        },
        "retained": [],
        "retained_raw": ""
      }
    },
    {
      "name": "a second pass appends a numbered segment",
      "note": "the index comes off the manifest's length, so it is 0002 with one already there",
      "input": {
        "active_content_lines": 3,
        "active_content": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n",
        "keep_last_n": 1,
        "existing_manifest": {
          "segments": [
            {
              "file": "0001.jsonl",
              "message_count": 4,
              "compacted_at": "2025-12-01T10:00:00-05:00"
            }
          ],
          "total_compacted_messages": 4
        },
        "on_disk_differs": false
      },
      "output": {
        "ok": true,
        "error": null,
        "returns_uuid": true,
        "segments": [
          {
            "file": "0002.jsonl",
            "lines": [
              "m_1",
              "m_2"
            ]
          }
        ],
        "manifest": {
          "segments": [
            {
              "file": "0001.jsonl",
              "message_count": 4,
              "compacted_at": "<stamp>"
            },
            {
              "file": "0002.jsonl",
              "message_count": 2,
              "compacted_at": "<stamp>"
            }
          ],
          "total_compacted_messages": 6
        },
        "retained": [
          "m_3"
        ],
        "retained_raw": "{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n"
      }
    },
    {
      "name": "blank lines are not messages",
      "note": "they are dropped before the split, so they cannot shift it",
      "input": {
        "active_content_lines": 4,
        "active_content": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n\n   \n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n",
        "keep_last_n": 1,
        "existing_manifest": null,
        "on_disk_differs": false
      },
      "output": {
        "ok": true,
        "error": null,
        "returns_uuid": true,
        "segments": [
          {
            "file": "0001.jsonl",
            "lines": [
              "m_1"
            ]
          }
        ],
        "manifest": {
          "segments": [
            {
              "file": "0001.jsonl",
              "message_count": 1,
              "compacted_at": "<stamp>"
            }
          ],
          "total_compacted_messages": 1
        },
        "retained": [
          "m_2"
        ],
        "retained_raw": "{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n"
      }
    },
    {
      "name": "the pre-read content wins over what is on disk",
      "note": "which is the whole reason it is passed in: the file may have grown since the pass parsed it, and archiving what it read is what keeps the two consistent",
      "input": {
        "active_content_lines": 3,
        "active_content": "{\"msg_id\":\"m_1\",\"role\":\"user\",\"content\":\"one\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"one\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_2\",\"role\":\"assistant\",\"content\":\"two\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"two\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n",
        "keep_last_n": 1,
        "existing_manifest": null,
        "on_disk_differs": true
      },
      "output": {
        "ok": true,
        "error": null,
        "returns_uuid": true,
        "segments": [
          {
            "file": "0001.jsonl",
            "lines": [
              "m_1",
              "m_2"
            ]
          }
        ],
        "manifest": {
          "segments": [
            {
              "file": "0001.jsonl",
              "message_count": 2,
              "compacted_at": "<stamp>"
            }
          ],
          "total_compacted_messages": 2
        },
        "retained": [
          "m_3"
        ],
        "retained_raw": "{\"msg_id\":\"m_3\",\"role\":\"user\",\"content\":\"three\",\"images\":[],\"content_blocks\":[{\"type\":\"text\",\"text\":\"three\"}],\"timestamp\":\"2026-01-01T10:00:00-05:00\"}\n"
      }
    },
    {
      "name": "an empty conversation writes nothing and empties nothing",
      "note": "there is no segment to write and no retained content to rewrite",
      "input": {
        "active_content_lines": 0,
        "active_content": "",
        "keep_last_n": 2,
        "existing_manifest": null,
        "on_disk_differs": false
      },
      "output": {
        "ok": true,
        "error": null,
        "returns_uuid": true,
        "segments": [],
        "manifest": null,
        "retained": [],
        "retained_raw": ""
      }
    }
  ],
  "resolve_compaction_deps": [
    {
      "name": "no templates on disk leaves both to the bundled defaults",
      "note": "the resolver answers None and the caller substitutes",
      "input": {
        "model_configured": true,
        "templates_on_disk": []
      },
      "output": {
        "system_template_override": null,
        "prompt_template_override": null,
        "model": "chat.fixture",
        "max_tool_iterations": 7,
        "display_name": "eshen",
        "compaction_settings": {
          "min_turns": 8,
          "max_turns": 16
        }
      }
    },
    {
      "name": "a character's own templates win",
      "note": "both are looked up per character, under the config dir",
      "input": {
        "model_configured": true,
        "templates_on_disk": [
          "compact_system.md",
          "compact.md"
        ]
      },
      "output": {
        "system_template_override": "# ada's system template",
        "prompt_template_override": "# ada's prompt template",
        "model": "chat.fixture",
        "max_tool_iterations": 7,
        "display_name": "eshen",
        "compaction_settings": {
          "min_turns": 8,
          "max_turns": 16
        }
      }
    },
    {
      "name": "one override and one default is allowed",
      "note": "they resolve independently; there is no all-or-nothing",
      "input": {
        "model_configured": true,
        "templates_on_disk": [
          "compact.md"
        ]
      },
      "output": {
        "system_template_override": null,
        "prompt_template_override": "# just the prompt",
        "model": "chat.fixture",
        "max_tool_iterations": 7,
        "display_name": "eshen",
        "compaction_settings": {
          "min_turns": 8,
          "max_turns": 16
        }
      }
    },
    {
      "name": "a global template is used when the character has none",
      "note": "two layers, character first",
      "input": {
        "model_configured": true,
        "templates_on_disk": [
          "global:compact.md"
        ]
      },
      "output": {
        "system_template_override": null,
        "prompt_template_override": "# the global prompt",
        "model": "chat.fixture",
        "max_tool_iterations": 7,
        "display_name": "eshen",
        "compaction_settings": {
          "min_turns": 8,
          "max_turns": 16
        }
      }
    },
    {
      "name": "a character's template beats the global one",
      "note": "which is the whole point of having two layers",
      "input": {
        "model_configured": true,
        "templates_on_disk": [
          "compact.md",
          "global:compact.md"
        ]
      },
      "output": {
        "system_template_override": null,
        "prompt_template_override": "# ada's prompt",
        "model": "chat.fixture",
        "max_tool_iterations": 7,
        "display_name": "eshen",
        "compaction_settings": {
          "min_turns": 8,
          "max_turns": 16
        }
      }
    },
    {
      "name": "no model configured resolves nothing",
      "note": "which the caller turns into a refusal rather than a default choice",
      "input": {
        "model_configured": false,
        "templates_on_disk": []
      },
      "output": {
        "system_template_override": null,
        "prompt_template_override": null,
        "model": null,
        "max_tool_iterations": null,
        "display_name": "eshen",
        "compaction_settings": {
          "min_turns": 8,
          "max_turns": 16
        }
      }
    }
  ],
  "dispatch_result_to_output": [
    {
      "name": "a string result is the model's text as-is",
      "note": "not re-serialized, so it carries no quotes",
      "output": "wrote memory/boats.md",
      "is_error": false
    },
    {
      "name": "an object result is serialized",
      "note": "compact JSON, which is what the model sees",
      "output": "{\"written\":[\"a.md\"],\"count\":1}",
      "is_error": false
    },
    {
      "name": "a number is serialized too",
      "note": "only a string is special-cased",
      "output": "42",
      "is_error": false
    },
    {
      "name": "a failure is the error's own text, flagged",
      "note": "the variant prefixes are part of the contract the model reads",
      "output": "invalid args: missing `path`",
      "is_error": true
    },
    {
      "name": "an io failure keeps its prefix",
      "note": "so a model can tell a bad argument from a disk that would not cooperate",
      "output": "io: permission denied",
      "is_error": true
    }
  ]
}