{
  "sanitize_tool_pairs": [
    {
      "name": "a healthy paired conversation is left alone",
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "read it"
            }
          ]
        },
        {
          "role": "assistant",
          "content": [
            {
              "type": "tool_use",
              "id": "t1",
              "name": "read_file",
              "input": {
                "path": "/tmp/x"
              }
            }
          ]
        },
        {
          "role": "user",
          "content": [
            {
              "type": "tool_result",
              "tool_use_id": "t1",
              "content": "ok"
            }
          ]
        },
        {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "done"
            }
          ]
        }
      ],
      "expect": null
    },
    {
      "name": "no tool blocks at all",
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "hi"
            }
          ]
        },
        {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "hello"
            }
          ]
        }
      ],
      "expect": null
    },
    {
      "name": "an orphan tool_use is stripped and its message disappears",
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "go"
            }
          ]
        },
        {
          "role": "assistant",
          "content": [
            {
              "type": "tool_use",
