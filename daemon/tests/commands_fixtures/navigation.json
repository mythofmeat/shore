{
  "list_characters": [
    {
      "name": "nothing on disk: the active character is still listed",
      "note": "The active character is prepended unconditionally — it does not have to be discoverable.",
      "ok": {
        "characters": [
          {
            "name": "solo"
          }
        ]
      }
    },
    {
      "name": "the active character leads, the rest follow sorted",
      "note": "`mid` sorts between `alpha` and `zulu`, so first-place is the active-character rule and not the sort.",
      "ok": {
        "characters": [
          {
            "name": "mid"
          },
          {
            "name": "alpha"
          },
          {
            "name": "zulu"
          }
        ]
      }
    },
    {
      "name": "an active character that is not on disk",
      "ok": {
        "characters": [
          {
            "name": "outsider"
          },
          {
            "name": "alpha"
          },
          {
            "name": "mid"
          },
          {
            "name": "zulu"
          }
        ]
      }
    },
    {
      "name": "discovery sorts by code point, not case-insensitively",
      "ok": {
        "characters": [
          {
            "name": "mid"
          },
          {
            "name": "Apple"
          },
          {
            "name": "Zebra"
          },
          {
            "name": "apple"
          }
        ]
      }
    },
    {
      "name": "a legacy character.md counts as a character",
      "ok": {
        "characters": [
          {
            "name": "mid"
          },
          {
            "name": "legacy"
          }
        ]
      }
    }
  ],
  "list_characters_standalone": [
    {
      "name": "avatar: png wins over every other extension",
      "note": "Also pins that the payload is base64 of the raw *bytes*: the file is not valid UTF-8.",
      "ok": {
        "characters": [
          {
            "name": "pngwins",
            "avatar": {
              "mime_type": "image/png",
              "data": "//4A"
            }
          }
        ]
      }
    },
    {
      "name": "avatar: jpg beats jpeg and webp",
      "note": "`abcd` encodes with padding, so a base64 that drops `=` differs.",
      "ok": {
        "characters": [
          {
            "name": "jpgwins",
            "avatar": {
              "mime_type": "image/jpeg",
              "data": "YWJjZA=="
            }
          }
        ]
      }
    },
    {
      "name": "avatar: jpeg beats webp",
      "ok": {
        "characters": [
          {
            "name": "jpegwins",
            "avatar": {
              "mime_type": "image/jpeg",
              "data": "anBlZzItYnl0ZXM="
            }
          }
        ]
      }
    },
    {
      "name": "avatar: webp is reached last",
      "ok": {
        "characters": [
          {
            "name": "webponly",
            "avatar": {
              "mime_type": "image/webp",
              "data": "d2VicC1ieXRlcw=="
            }
          }
        ]
      }
    },
    {
      "name": "avatar: a zero-byte file is skipped, not embedded empty",
      "note": "The probe continues to the next extension rather than reporting an avatar with no data.",
      "ok": {
        "characters": [
          {
            "name": "emptypng",
            "avatar": {
              "mime_type": "image/jpeg",
              "data": "anBlZy1ieXRlcw=="
            }
          }
        ]
      }
    },
    {
      "name": "avatar: a directory named avatar.png is not a file",
      "note": "`is_file` rather than `exists`.",
      "ok": {
        "characters": [
          {
            "name": "dirpng",
            "avatar": {
              "mime_type": "image/jpeg",
              "data": "anBlZy1ieXRlcw=="
            }
          }
        ]
      }
    },
    {
      "name": "avatar: only the four exact names in the character directory",
      "note": "The probe is case-sensitive, takes no bare `avatar`, and does not look inside `workspace/`.",
      "ok": {
        "characters": [
          {
            "name": "noavatar"
          }
        ]
      }
    },
    {
      "name": "standalone does not prepend the active character",
      "note": "Same tree as the listing case above; `mid` appears in sorted position, not first.",
      "ok": {
        "characters": [
          {
            "name": "alpha"
          },
          {
            "name": "mid"
          },
          {
            "name": "zulu"
          }
        ]
      }
    },
    {
      "name": "standalone with nothing on disk is empty",
      "note": "The engine's character is not consulted at all — the listing case with the same tree returns one entry.",
      "ok": {
        "characters": []
      }
    },
    {
      "name": "standalone when characters/ is a file",
      "ok": {
        "characters": []
      }
    }
  ],
