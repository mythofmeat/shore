  "switch_character": [
    {
      "name": "a different character that exists",
      "ok": {
        "character": "alpha",
        "changed": true
      }
    },
    {
      "name": "switching to the active character changes nothing",
      "ok": {
        "character": "mid",
        "changed": false
      }
    },
    {
      "name": "the active character does not have to exist on disk",
      "note": "The same-name check runs before the directory probe.",
      "ok": {
        "character": "outsider",
        "changed": false
      }
    },
    {
      "name": "a character that does not exist",
      "err": {
        "code": "not_found",
        "message": "Character not found: ghost"
      }
    },
    {
      "name": "no name argument",
      "err": {
        "code": "invalid_request",
        "message": "Missing required argument: name"
      }
    },
    {
      "name": "a non-string name argument is a missing one",
      "note": "`as_str` is `None`, so this takes the missing-argument branch rather than searching for a character named `7`.",
      "err": {
        "code": "invalid_request",
        "message": "Missing required argument: name"
      }
    },
    {
      "name": "an empty name resolves to the characters directory itself",
      "note": "`join(\"\")` is the parent, which exists — so the empty string passes the probe and is reported as a switch. Pinned as-is: the daemon never sends it and fixing it here would put the port out of step with the Rust.",
      "ok": {
        "character": "",
        "changed": true
      }
    },
    {
      "name": "an existing directory that is not a discoverable character",
      "note": "`exists()`, not discovery — the same divergence `character_info` has.",
      "ok": {
        "character": "undiscoverable",
        "changed": true
      }
    }
  ],
