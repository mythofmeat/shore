  "config_check": [
    {
      "name": "a config with a missing api key env var",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": true,
        "defaults_model": "anthropic:claude-primary",
        "chat_models": 2
      },
      "note": "`SHORE_FIXTURE_KEY_SET` is set and `SHORE_FIXTURE_KEY_MISSING` is not, so exactly one model warns.",
      "ok": {
        "valid": false,
        "warnings": [
          "API key env var $ANTHROPIC_API_KEY not set (needed by model anthropic:claude-primary)"
        ],
        "info": [
          "2 chat model(s) configured",
          "Default model: anthropic:claude-primary"
        ],
        "config_dir": "<root>/config",
        "data_dir": "<root>/data-home/shore",
        "cache_dir": "<root>/cache-home/shore",
        "chat_models": 2,
        "providers": 2
      }
    },
    {
      "name": "no models at all",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": false,
        "defaults_model": null,
        "chat_models": 0
      },
      "note": "The no-models warning fires and the no-default-model warning does not \u2014 it is gated on the catalog being non-empty.",
      "ok": {
        "valid": false,
        "warnings": [
          "No chat models configured. Add a [providers.*] entry and set chat.model to a provider:model_id."
        ],
        "info": [],
        "config_dir": "<root>/config",
        "data_dir": "<root>/data-home/shore",
        "cache_dir": "<root>/cache-home/shore",
        "chat_models": 0,
        "providers": 0
      }
    },
    {
      "name": "an api key env var that is set but empty",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": false,
        "defaults_model": null,
        "chat_models": 1
      },
      "note": "`std::env::var` gives `Ok(\"\")`, so a blank value counts as set and the only warning is the missing default model.",
      "ok": {
        "valid": false,
        "warnings": [
          "No default model set. First chat model will be used.",
          "API key env var $ANTHROPIC_API_KEY not set (needed by model anthropic:claude-blank)"
        ],
        "info": [
          "1 chat model(s) configured"
        ],
        "config_dir": "<root>/config",
        "data_dir": "<root>/data-home/shore",
        "cache_dir": "<root>/cache-home/shore",
        "chat_models": 1,
        "providers": 1
      }
    },
    {
      "name": "a default model that is not in the catalog",
      "state_after": {
