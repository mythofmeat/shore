        ],
        "info": [],
        "config_dir": "<root>/config",
        "data_dir": "<root>/data-home/shore",
        "cache_dir": "<root>/cache-home/shore",
        "chat_models": 0,
        "providers": 0
      }
    },
    {
      "name": "models but no default set",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": false,
        "defaults_model": null,
        "chat_models": 1
