  "config_reload": [
    {
      "name": "check mode reports without applying",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": true,
        "defaults_model": "anthropic:claude-primary",
        "chat_models": 2
      },
      "note": "No `prompts_refreshed` field at all in check mode \u2014 not `false`.",
      "ok": {
        "applied": false,
        "config_path": "<root>/config/config.toml",
        "character": "mid",
        "changed_prompt_files": []
      }
    },
    {
      "name": "a truthy non-boolean apply is not an apply",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": true,
        "defaults_model": "anthropic:claude-primary",
        "chat_models": 2
      },
      "note": "`as_bool` on a number is `None`, so both flags fall back to false and this is check mode.",
      "ok": {
        "applied": false,
        "config_path": "<root>/config/config.toml",
        "character": "mid",
        "changed_prompt_files": []
      }
    },
    {
      "name": "apply adopts the config on disk",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": false,
        "defaults_model": "anthropic:claude-third",
        "chat_models": 1
      },
      "note": "`state_after` is the whole point: three chat models now, and `defaults_model` moved.",
      "ok": {
        "applied": true,
        "config_path": "<root>/config/config.toml",
        "character": "mid",
        "changed_prompt_files": [],
        "prompts_refreshed": false
      }
    },
    {
      "name": "a broken config aborts before adopting anything",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": true,
        "defaults_model": "anthropic:claude-primary",
        "chat_models": 2
      },
      "note": "`state_after` still shows the original config \u2014 the failure is before any mutation.",
      "err": {
        "code": "invalid_request",
        "message": "Config error: failed to parse config.toml: TOML Parse error: Expected '=' after a key but found 'i'"
      }
    },
    {
      "name": "a broken character overlay aborts the reload",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": true,
        "defaults_model": "anthropic:claude-primary",
        "chat_models": 2
      },
      "note": "The overlay is validated against the *fresh* global config, so a typo in one character's config.toml stops the whole reload rather than silently falling back at merge time.",
      "err": {
        "code": "invalid_request",
        "message": "Config error in character overlay 'broken': failed to parse include file <root>/config/characters/broken/config.toml: TOML Parse error: Unterminated array; expected ']'"
      }
    },
    {
      "name": "reload with no character context",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": true,
        "defaults_model": "anthropic:claude-primary",
        "chat_models": 2
      },
      "err": {
        "code": "invalid_request",
        "message": "config_reload requires a character context"
      }
    },
    {
      "name": "check mode lists the prompt files that differ",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": true,
        "defaults_model": "anthropic:claude-primary",
        "chat_models": 2
      },
      "note": "SOUL.md differs from its snapshot and USER.md matches, so exactly one file is reported. Nothing is applied.",
      "ok": {
        "applied": false,
        "config_path": "<root>/config/config.toml",
        "character": "mid",
        "changed_prompt_files": [
          "SOUL.md"
        ]
      }
    },
    {
      "name": "a prompt file with no snapshot at all is changed",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": true,
        "defaults_model": "anthropic:claude-primary",
        "chat_models": 2
      },
      "ok": {
        "applied": false,
        "config_path": "<root>/config/config.toml",
        "character": "mid",
        "changed_prompt_files": [
          "SOUL.md"
        ]
      }
    },
    {
      "name": "apply with refresh_prompts activates the pending edits",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": true,
        "defaults_model": "anthropic:claude-primary",
        "chat_models": 2
      },
      "note": "`prompts_refreshed` is true only on this path. `changed_after` is what says the snapshot was actually rewritten: the same call in check mode leaves it non-empty.",
      "ok": {
        "applied": true,
        "config_path": "<root>/config/config.toml",
        "character": "mid",
        "changed_prompt_files": [
          "SOUL.md"
        ],
        "prompts_refreshed": true
      },
      "changed_after": []
    },
    {
      "name": "apply without refresh_prompts leaves the snapshot alone",
      "state_after": {
        "active_model": null,
        "autonomy_enabled": true,
        "defaults_model": "anthropic:claude-primary",
        "chat_models": 2
      },
      "note": "The mirror of the case above: same tree, same adopt, but `changed_after` still lists SOUL.md.",
      "ok": {
        "applied": true,
        "config_path": "<root>/config/config.toml",
        "character": "mid",
        "changed_prompt_files": [
          "SOUL.md"
        ],
        "prompts_refreshed": false
      },
      "changed_after": [
        "SOUL.md"
      ]
    }
  ]
}
