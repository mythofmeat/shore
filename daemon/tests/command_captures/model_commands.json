        },
        {
          "args": {},
          "op": "model_settings"
        },
        {
          "op": "model_roles",
          "args": {}
        }
      ]
    },
    {
      "name": "a hidden model selected on the session, without a pre-resolved copy",
      "note": "the fallback resolve passes include_hidden, because the user has already chosen this selection and refusing to describe it would be absurd",
      "setup": {
        "catalog": "",
        "defaults": "\n",
        "discovery": [
          {
            "provider": "openrouter",
            "models": [
              {
                "model_id": "vendor/visible",
                "visible": true
              },
              {
                "model_id": "vendor/hidden",
                "visible": false
              }
            ]
          }
        ],
        "character": "Tester",
        "global_prefs": null,
        "character_prefs": null,
        "active_model": "openrouter:vendor/hidden"
      },
      "steps": [
        {
          "op": "list_models",
          "args": {}
        },
        {
          "op": "model_info",
          "args": {},
          "err": {
            "code": "invalid_request",
            "message": "No model specified and no active model set"
          }
        },
        {
          "op": "model_settings",
          "args": {},
          "err": {
            "code": "invalid_request",
            "message": "No model specified and no active model set"
          }
        },
        {
          "op": "set_model_setting",
          "args": {
            "key": "max_output_tokens",
            "value": 256
          },
          "err": {
            "code": "invalid_request",
            "message": "No model specified and no active model set"
          }
        }
      ]
    },
    {
