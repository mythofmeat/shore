    {
      "name": "discovered models, some hidden",
      "note": "`discovery.ignore` hides a model from the list and from selection, and include_hidden is the per-call opt-in past both",
      "setup": {
        "catalog": "",
        "defaults": "\n",
        "discovery": [
          {
            "provider": "openrouter",
            "models": [
              {
                "model_id": "vendor/visible",
                "visible": true
              },
              {
                "model_id": "vendor/hidden",
                "visible": false
              }
            ]
          }
        ],
        "character": "Tester",
        "global_prefs": null,
        "character_prefs": null,
        "active_model": null
      },
      "steps": [
        {
          "op": "list_models",
          "args": {}
        },
        {
          "op": "list_models",
          "args": {
            "include_hidden": true
          }
        },
        {
          "op": "model_info",
          "args": {
            "name": "openrouter:vendor/visible"
          }
        },
        {
          "op": "model_info",
          "args": {
            "name": "openrouter:vendor/hidden"
          }
        },
        {
          "op": "switch_model",
          "args": {
            "name": "openrouter:vendor/hidden"
          },
          "err": {
            "code": "not_found",
            "message": "model \"openrouter:vendor/hidden\" is hidden by [providers.openrouter.discovery.ignore]; pass include_hidden=true or update the ignore rules to allow it"
          }
        },
        {
          "op": "switch_model",
          "args": {
            "name": "openrouter:vendor/hidden",
            "include_hidden": true
          },
          "prefs_changed": {
            "character_exists": true,
            "character.selected.provider": "openrouter",
            "character.selected.model_id": "vendor/hidden"
          }
        },
        {
          "op": "list_models",
          "args": {}
        },
        {
          "op": "model_info",
          "args": {}
        },
        {
          "op": "model_settings",
          "args": {}
        },
        {
          "op": "set_model_setting",
          "args": {
            "key": "reasoning_effort",
            "value": "high"
          },
          "prefs_changed": {
            "character.models.openrouter:vendor/hidden.reasoning_effort": "high"
          }
        },
        {
          "op": "model_settings",
          "args": {}
        }
      ]
    },
    {
      "name": "a pre-resolved discovered model on the session",
      "note": "the dispatcher hands over a ResolvedModel because a discovered model's synthetic qualified_name is display-only and the resolver rejects it as input; every command must read the resolved value rather than re-resolving",
      "setup": {
        "catalog": "",
        "defaults": "\n",
        "discovery": [
          {
            "provider": "openrouter",
            "models": [
              {
                "model_id": "vendor/visible",
                "visible": true
              }
            ]
          }
        ],
        "character": "Tester",
        "global_prefs": null,
        "character_prefs": null,
        "active_model": "chat.openrouter.vendor/visible"
      },
      "steps": [
        {
          "op": "list_models",
          "args": {}
        },
        {
          "op": "model_info",
          "args": {},
          "err": {
            "code": "invalid_request",
            "message": "No model specified and no active model set"
          }
        },
        {
          "op": "model_settings",
          "args": {},
          "err": {
            "code": "invalid_request",
            "message": "No model specified and no active model set"
          }
