    {
      "name": "background pins, per-task and blanket",
      "note": "heartbeat is pinned per task and compaction falls back to the blanket pin, so `all` cannot collapse and says which task to target instead",
      "setup": {
        "catalog": "[chat.\"anthropic:alpha-id\"]\nsdk = \"anthropic\"\ntemperature = 0.5\n\n[chat.\"anthropic:beta-id\"]\nsdk = \"anthropic\"\ntemperature = 0.2\n\n[chat.\"anthropic:claude-opus-4-8\"]\nsdk = \"anthropic\"\n\n[chat.\"openai:gamma-id\"]\nsdk = \"openai\"\n\n[chat.\"gemini:gemini-3.1-pro\"]\nsdk = \"gemini\"\n",
        "defaults": "[chat]\nmodel = \"alpha-id\"\n\n[heartbeat]\nmodel = \"gamma-id\"\n\n[compaction]\nmodel = \"beta-id\"\n",
        "discovery": [],
        "character": "Tester",
        "global_prefs": null,
        "character_prefs": null,
        "active_model": null
      },
      "steps": [
        {
          "op": "model_roles",
          "args": {}
        },
        {
          "op": "model_settings",
          "args": {
            "background_task": "heartbeat"
          }
        },
        {
          "op": "model_settings",
          "args": {
            "background_task": "compaction"
          }
        },
        {
          "op": "model_settings",
          "args": {
            "background_task": "all"
          },
          "err": {
            "code": "invalid_request",
            "message": "background tasks use different models (heartbeat \u2192 openai:gamma-id, compaction \u2192 anthropic:beta-id); target a specific task instead of `all`"
          }
        },
        {
          "op": "model_settings",
          "args": {
            "background_task": "dreaming"
          },
          "err": {
            "code": "invalid_request",
            "message": "unknown background task: dreaming; expected all, heartbeat, or compaction"
          }
        },
        {
          "op": "model_settings",
          "args": {
            "background_task": "bogus"
          },
          "err": {
            "code": "invalid_request",
            "message": "unknown background task: bogus; expected all, heartbeat, or compaction"
          }
        },
        {
          "op": "set_model_setting",
          "args": {
            "key": "temperature",
            "value": 0.1,
            "background_task": "heartbeat"
          },
          "prefs_changed": {
            "character_exists": true,
            "character.models.openai:gamma-id.temperature": 0.1
          }
        },
        {
          "op": "set_model_setting",
          "args": {
            "key": "temperature",
            "value": 0.2,
            "background_task": "all"
          },
          "err": {
            "code": "invalid_request",
            "message": "background tasks use different models (heartbeat \u2192 openai:gamma-id, compaction \u2192 anthropic:beta-id); target a specific task instead of `all`"
          }
        },
        {
          "op": "model_settings",
          "args": {
            "background_task": "heartbeat"
          }
        },
        {
          "op": "set_model_setting",
          "args": {
            "key": "top_p",
            "value": 0.3,
            "background_task": "compaction",
            "name": "alpha-id"
          },
          "prefs_changed": {
            "character.models.anthropic:beta-id.top_p": 0.3
          }
        },
        {
          "op": "model_settings",
          "args": {
            "name": "beta-id"
          }
        }
      ]
    },
