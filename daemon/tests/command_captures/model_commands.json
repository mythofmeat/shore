{
  "scenarios": [
    {
      "name": "a static catalog, and switching within it",
      "note": "the config default is deliberately NOT the first catalog entry, so `defaults.model` and the first-entry fallback are distinguishable; the active model then moves as the session does, and each switch is persisted as (provider, model_id) rather than as the name typed",
      "setup": {
        "catalog": "[chat.\"anthropic:alpha-id\"]\nsdk = \"anthropic\"\ntemperature = 0.5\n\n[chat.\"anthropic:beta-id\"]\nsdk = \"anthropic\"\ntemperature = 0.2\n\n[chat.\"anthropic:claude-opus-4-8\"]\nsdk = \"anthropic\"\n\n[chat.\"openai:gamma-id\"]\nsdk = \"openai\"\n\n[chat.\"gemini:gemini-3.1-pro\"]\nsdk = \"gemini\"\n",
        "defaults": "[chat]\nmodel = \"beta-id\"\n",
        "discovery": [],
        "character": "Tester",
        "global_prefs": null,
        "character_prefs": null,
        "active_model": null
      },
      "steps": [
        {
          "args": {},
          "op": "list_models"
        },
        {
          "op": "list_models",
          "args": {
            "include_hidden": true
          }
        },
        {
          "args": {},
          "op": "model_info"
        },
        {
          "op": "model_info",
          "args": {
            "name": "beta-id"
          }
        },
        {
          "op": "model_info",
          "args": {
            "name": "nope"
          },
          "err": {
            "code": "not_found",
            "message": "model \"nope\" not found in static catalog or discovered models"
          }
        },
        {
          "op": "model_info",
          "args": {
            "name": ""
          }
        },
        {
          "op": "model_settings",
          "args": {
            "name": ""
          }
        },
        {
          "op": "model_settings",
          "args": {}
        },
        {
          "op": "switch_model",
          "args": {}
        },
        {
          "op": "switch_model",
          "args": {
            "name": "beta-id"
          },
          "prefs_changed": {
            "character_exists": true,
            "character.selected.provider": "anthropic",
            "character.selected.model_id": "beta-id"
          }
        },
        {
          "args": {},
          "op": "list_models"
        },
        {
          "args": {},
          "op": "model_info"
        },
        {
          "op": "model_settings",
          "args": {}
        },
        {
          "op": "switch_model",
          "args": {
            "name": "nope"
          },
          "err": {
            "code": "not_found",
            "message": "model \"nope\" not found in static catalog or discovered models"
          }
        },
        {
          "op": "switch_model",
          "args": {
            "name": "openai:missing-id"
          },
          "err": {
            "code": "not_found",
            "message": "model \"openai:missing-id\" not found in static catalog or discovered models"
          }
        },
        {
          "args": {},
          "op": "list_models"
        },
        {
          "op": "reset_model",
          "args": {},
          "prefs_changed": {
            "character.selected.provider": null,
            "character.selected.model_id": null
          }
        },
        {
          "args": {},
          "op": "list_models"
        },
        {
          "args": {},
          "op": "model_info"
        },
        {
          "op": "reset_model",
          "args": {}
        },
        {
          "op": "model_settings",
          "args": {
            "name": "anthropic:claude-opus-4-8"
          }
        },
        {
          "op": "model_settings",
          "args": {
            "name": "gemini:gemini-3.1-pro"
          }
        },
        {
          "op": "set_model_setting",
          "args": {
            "key": "zai_clear_thinking",
            "value": true,
            "name": "anthropic:claude-opus-4-8"
          },
          "err": {
            "code": "invalid_request",
            "message": "`zai_clear_reasoning` is not applicable to the `anthropic` sdk for this model"
          }
        },
        {
          "op": "set_model_setting",
          "args": {
            "key": "gemini_generation",
            "value": 2,
            "name": "gemini:gemini-3.1-pro"
          },
          "prefs_changed": {
            "character.models.gemini:gemini-3.1-pro.gemini_generation": 2
          }
        },
        {
          "op": "set_model_setting",
          "args": {
            "key": "reasoning_effort",
            "value": "max",
            "name": "gemini:gemini-3.1-pro"
          },
          "err": {
            "code": "invalid_request",
            "message": "`reasoning_effort` value \"max\" is out of domain; allowed: minimal, low, medium, high"
          }
        }
      ]
    },
    {
      "name": "a model id that two providers both discovered",
      "note": "the only route to the catalog's Ambiguous error, which is the one kind it reports as a bad request rather than a miss \u2014 a bare id has to be unique across every enabled provider's cache",
      "setup": {
        "catalog": "[chat.\"anthropic:a-id\"]\nsdk = \"anthropic\"\n\n[chat.\"openai:o-id\"]\nsdk = \"openai\"\n",
        "defaults": "\n",
        "discovery": [
          {
            "provider": "openrouter",
            "models": [
              {
                "model_id": "shared/id",
                "visible": true
              }
            ]
          },
          {
            "provider": "groq",
            "models": [
              {
                "model_id": "shared/id",
                "visible": true
              }
            ]
          }
        ],
        "character": "Tester",
        "global_prefs": null,
        "character_prefs": null,
        "active_model": null
      },
      "steps": [
        {
          "op": "model_info",
          "args": {
            "name": "shared/id"
          },
          "err": {
            "code": "invalid_request",
            "message": "model name \"shared/id\" is ambiguous across providers: groq:shared/id, openrouter:shared/id"
          }
        },
        {
          "op": "model_settings",
          "args": {
            "name": "shared/id"
          },
          "err": {
            "code": "invalid_request",
            "message": "model name \"shared/id\" is ambiguous across providers: groq:shared/id, openrouter:shared/id"
          }
        },
        {
          "op": "switch_model",
          "args": {
            "name": "shared/id"
          },
          "err": {
            "code": "invalid_request",
            "message": "model name \"shared/id\" is ambiguous across providers: groq:shared/id, openrouter:shared/id"
          }
        },
        {
          "op": "model_info",
          "args": {
            "name": "openrouter:shared/id"
          }
        },
        {
          "op": "set_model_setting",
          "args": {
            "key": "temperature",
            "value": 0.5,
            "name": "shared/id"
          },
          "err": {
            "code": "invalid_request",
            "message": "model name \"shared/id\" is ambiguous across providers: groq:shared/id, openrouter:shared/id"
          }
        },
        {
          "op": "model_info",
          "args": {
            "name": "shared"
          },
          "err": {
            "code": "not_found",
            "message": "model \"shared\" not found in static catalog or discovered models"
          }
        }
      ]
    },
    {
      "name": "a background pin that does not resolve",
      "note": "a diagnostic, so the row echoes the name the user wrote rather than failing \u2014 but a settings command targeting that task still errors",
      "setup": {
        "catalog": "[chat.\"anthropic:alpha-id\"]\nsdk = \"anthropic\"\ntemperature = 0.5\n\n[chat.\"anthropic:beta-id\"]\nsdk = \"anthropic\"\ntemperature = 0.2\n\n[chat.\"anthropic:claude-opus-4-8\"]\nsdk = \"anthropic\"\n\n[chat.\"openai:gamma-id\"]\nsdk = \"openai\"\n\n[chat.\"gemini:gemini-3.1-pro\"]\nsdk = \"gemini\"\n",
        "defaults": "[chat]\nmodel = \"alpha-id\"\n\n[heartbeat]\nmodel = \"ghost\"\n",
        "discovery": [],
        "character": "Tester",
        "global_prefs": null,
        "character_prefs": null,
        "active_model": null
      },
      "steps": [
        {
          "op": "model_roles",
          "args": {}
        },
        {
          "op": "model_settings",
          "args": {
            "background_task": "heartbeat"
          },
          "err": {
            "code": "not_found",
            "message": "model \"ghost\" not found in static catalog or discovered models"
          }
        },
        {
          "op": "model_settings",
          "args": {
            "background_task": "all"
          },
          "err": {
            "code": "not_found",
            "message": "model \"ghost\" not found in static catalog or discovered models"
          }
        }
      ]
    },
    {
      "name": "a session active_model that resolves nowhere",
      "note": "list_models still reports it as the active name rather than swallowing it, and every command that must actually resolve it fails",
      "setup": {
        "catalog": "[chat.\"anthropic:alpha-id\"]\nsdk = \"anthropic\"\ntemperature = 0.5\n\n[chat.\"anthropic:beta-id\"]\nsdk = \"anthropic\"\ntemperature = 0.2\n\n[chat.\"anthropic:claude-opus-4-8\"]\nsdk = \"anthropic\"\n\n[chat.\"openai:gamma-id\"]\nsdk = \"openai\"\n\n[chat.\"gemini:gemini-3.1-pro\"]\nsdk = \"gemini\"\n",
        "defaults": "[chat]\nmodel = \"alpha-id\"\n",
        "discovery": [],
        "character": "Tester",
        "global_prefs": null,
        "character_prefs": null,
        "active_model": "ghost"
