{
  "name": "@shore/daemon",
  "version": "4.60.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/daemon/run.ts",
    "build": "bun run build:patch && bun run build:daemon",
    "build:daemon": "bun run browser:build && bun build src/daemon/main.ts --compile --outfile dist/shore-daemon && bun run build:claude",
    "build:claude": "bun run scripts/build_claude.ts",
    "typecheck": "tsc --noEmit && tsc --project src/browser/tsconfig.json && tsc --project tests/dom/tsconfig.json",
    "lint:comments": "bun run scripts/check_no_comments.ts",
    "lint": "oxlint --type-aware src tests scripts",
    "test": "bun test",
    "lint:test-env": "bun run scripts/check_test_env.ts",
    "mutate": "bun run scripts/mutate.ts",
    "build:patch": "bun run scripts/build_patch.ts",
    "inventory:generate": "bun run scripts/capability_inventory.ts --write",
    "browser:generate": "bun run scripts/browser_validators.ts --write",
    "browser:check": "bun run scripts/capability_inventory.ts && bun run scripts/browser_validators.ts && bun run scripts/build_browser.ts --check",
    "browser:build": "bun run scripts/build_browser.ts",
    "test:browser": "bun run build && playwright test"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.81",
    "@ai-sdk/moonshotai": "^3.0.87",
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@anthropic-ai/sdk": "^1.6.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@google/genai": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@replit/codemirror-vim": "^6.4.0",
    "ai": "^7.0.166",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "matrix-js-sdk": "^45.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "openai": "^7.53.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar": "^7.5.22",
    "uqr": "^0.1.3",
    "zhipu-ai-provider": "^0.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "6.2.6",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  }
}
