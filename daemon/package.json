{
  "name": "@shore/daemon",
  "version": "4.19.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/daemon/run.ts",
    "build": "bun run build:patch && bun run build:daemon",
    "build:daemon": "bun run browser:build && bun build src/daemon/run.ts --compile --outfile dist/shore-daemon && bun run build:claude",
    "build:claude": "bun run scripts/build_claude.ts",
    "typecheck": "tsc --noEmit && tsc --project src/browser/tsconfig.json",
    "lint:comments": "bun run scripts/check_no_comments.ts",
    "lint": "oxlint --type-aware src tests scripts",
    "test": "bun test",
    "lint:citations": "bun run scripts/check_live_citations.ts",
    "lint:test-env": "bun run scripts/check_test_env.ts",
    "mutate": "bun run scripts/mutate.ts",
    "rerecord": "bun run scripts/rerecord.ts",
    "rerecord:check": "bun run scripts/rerecord.ts --check",
    "build:patch": "bun run scripts/build_patch.ts",
    "inventory:generate": "bun run scripts/capability_inventory.ts --write",
    "browser:generate": "bun run scripts/browser_validators.ts --write",
    "browser:check": "bun run scripts/browser_validators.ts && bun run scripts/build_browser.ts --check",
    "browser:build": "bun run scripts/build_browser.ts",
    "test:browser": "bun run build && playwright test",
    "inventory:check": "bun run scripts/capability_inventory.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.58",
    "@ai-sdk/moonshotai": "^3.0.62",
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.25.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.126",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "matrix-js-sdk": "^43.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "openai": "^7.25.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tar": "^7.5.22",
    "zhipu-ai-provider": "^0.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/mdast": "^4.0.4",
    "oxlint": "^1.86.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  }
}
