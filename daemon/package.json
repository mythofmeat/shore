{
  "name": "@shore/daemon",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/daemon/run.ts",
    "build": "bun build src/daemon/run.ts --compile --outfile dist/shore-daemon",
    "typecheck": "tsc --noEmit",
    "lint:comments": "bun run scripts/check_no_comments.ts",
    "lint": "oxlint --type-aware src tests scripts",
    "test": "bun test",
    "lint:citations": "bun run scripts/check_live_citations.ts",
    "mutate": "bun run scripts/mutate.ts",
    "rerecord": "bun run scripts/rerecord.ts",
    "rerecord:check": "bun run scripts/rerecord.ts --check",
    "postinstall": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.39",
    "@ai-sdk/moonshotai": "^3.0.45",
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@anthropic-ai/sdk": "^0.123.0",
    "@google/genai": "^2.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.91",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "matrix-js-sdk": "^42.3.0",
    "openai": "^7.9.0",
    "tar": "^7.5.22",
    "zhipu-ai-provider": "^0.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
