    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/sdk": "^1.2.37",
    "ai": "^7.0.66",
    "matrix-js-sdk": "^42.1.0",
    "openai": "^7.4.0",
    "zhipu-ai-provider": "^0.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
