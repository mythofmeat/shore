[Unit]
StartLimitIntervalSec= 30m
StartLimitBurst= 10

[Service]
Type= exec
ExecSearchPath= /usr/bin:/usr/local/bin
ExecStart= shore-daemon
Restart= on-failure
RestartMaxDelaySec= 1min
RestartSteps= 10

Environment= SHORE_LLM_SIDECAR_BIN=/usr/local/lib/shore/shore-llm-sidecar
Environment= SHORE_MATRIX_BIN=/usr/local/lib/shore/shore-matrix

[Install]
WantedBy= default.target
