pkgname=shore-cli
pkgver=0
pkgrel=1
pkgdesc="Persistent AI character engine — CLI and terminal chat client"
arch=('x86_64')
url="https://github.com/mythofmeat/shore"
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('rust' 'git')
optdepends=('wl-clipboard: ctrl+v image paste from clipboard (Wayland)' 'yazi: image picker')
options=(!lto !debug strip)

pkgver() {
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
    cd "$startdir/../../client"
    cargo build --release --bin shore
}

package() {
    cd "$startdir/../../"
    install -Dm644 "./LICENSE-MIT" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm644 "./LICENSE-APACHE-2.0" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE-2.0"

    cd "./client/target/release"
    install -Dm755 "./shore" "$pkgdir/usr/bin/shore"

    install -dm755 "$pkgdir/usr/share/fish/vendor_completions.d"
    install -dm755 "$pkgdir/usr/share/bash-completion/completions"
    install -dm755 "$pkgdir/usr/share/zsh/site-functions"
    ./shore completions fish \
        > "$pkgdir/usr/share/fish/vendor_completions.d/shore.fish"
    ./shore completions bash \
        > "$pkgdir/usr/share/bash-completion/completions/shore"
    ./shore completions zsh \
        > "$pkgdir/usr/share/zsh/site-functions/_shore"

}
