# Maintainer: eshen
pkgname=shore-tui
pkgver=0.20.0
pkgrel=1
pkgdesc='Terminal UI client for the Silvershore chat daemon'
arch=('x86_64')
url='https://github.com/mythofmeat/shore'
license=('MIT OR Apache-2.0')
depends=('gcc-libs')
optdepends=('wl-clipboard: ctrl+v image paste from clipboard (Wayland)')
makedepends=('cargo' 'git')
provides=('shore-tui')
conflicts=('shore-tui' 'shore-git')
source=("shore::git+ssh://git@github.com/mythofmeat/shore.git")
options=('!lto' '!debug' 'strip')
sha256sums=('SKIP')

prepare() {
    cd shore
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd shore
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # tui-release is the size-focused profile (opt-level=z, panic=abort)
    # defined in the workspace root Cargo.toml.
    cargo build --frozen -p shore-tui --profile tui-release
}

package() {
    cd shore
    install -Dm755 target/tui-release/shore-tui "$pkgdir/usr/bin/shore-tui"
}
